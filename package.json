{
  "name": "ccautopsy",
  "version": "0.1.0",
  "description": "Find out why your Claude Code usage quota disappeared: finds prompt-cache rebuilds in local transcripts and explains each one.",
  "license": "MIT",
  "author": "Elvinas Miltenis",
  "type": "module",
  "bin": {
    "ccautopsy": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --format=esm --packages=external --banner='#!/usr/bin/env node' --outfile=dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "claude-code",
    "prompt-cache",
    "tokens",
    "usage",
    "cli"
  ],
  "dependencies": {
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eldevia/ccautopsy.git"
  },
  "homepage": "https://github.com/Eldevia/ccautopsy#readme",
  "bugs": {
    "url": "https://github.com/Eldevia/ccautopsy/issues"
  }
}

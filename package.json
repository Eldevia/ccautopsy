{
  "name": "ccautopsy",
  "version": "0.1.0",
  "description": "Find out why your Claude Code usage quota disappeared: finds prompt-cache rebuilds in local transcripts and explains each one.",
  "license": "MIT",
  "author": "Elvinas Miltenis",
  "type": "module",
  "bin": {
    "ccautopsy": "dist/cli.js"
  },
